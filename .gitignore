# 密钥
.env

# 登录态：统一身份认证的 Cookie 与（可选的）账号密码 —— 绝对不能提交
.auth/

# Windows 文件权限排查留下的报告（可删）
.acl-reports/

# 抓取数据（含校内语料，要求数据本地化，不入库）
#
# 计算器的数据在 calcdata/（不在 data/ 下），不受这一条影响。
# data/calc/ 是可选的本地覆盖目录：把 calcdata/ 里的某个文件复制过去再改，
# 就会覆盖仓库自带的版本，且不会被 git 跟踪。
data/*
!data/README.md
*.db
*.db-wal
*.db-shm

# 测试临时目录（跑完会自动清理）
_test_tmp/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp
.DS_Store

# 导出的问答结果
out/
*.answer.json
