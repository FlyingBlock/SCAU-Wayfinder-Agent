# ===== SCAU Wayfinder 配置 =====
# 复制为 .env 后按需填写。.env 已在 .gitignore 中，不会入库。
#
# 更省事的两种填法（都会先做一次真实调用验证再写进 .env，与手改本文件等价）：
#     python -m wayfinder setup-key          # 命令行
#     python -m wayfinder web → 左下角「⚙️ 设置」  # Web 界面
#
# 注意：设置面板与 setup-key 写的是下面这三个**通用名字**（LLM_*），
# 并会顺手清掉同一文件里旧的 DEEPSEEK_* 配置，避免两套 key 互相打架。

# ---- LLM（问答必填；计算器不需要）----
# 任意 OpenAI 兼容端点都行。申请： https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-在这里粘贴你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 换成本机模型（Ollama / vLLM）时，key 随便填一个非空值：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# 单次生成上限（默认 8192）。思维链模型会先花几千 token 思考，
# 太小会出现空正文；程序检测到截断会自动翻倍重试。
# LLM_MAX_TOKENS=16384

# ---- 公网搜索（可选）----
# ddg    = DuckDuckGo Lite，无需 key（默认）
# bocha  = 博查搜索（https://open.bochaai.com）
# tavily = Tavily（https://tavily.com）
# none   = 关闭公网检索，只用校内语料
WEB_SEARCH_PROVIDER=ddg
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ---- 附件解析与 OCR ----
# 通知附件（pdf/doc/docx/xls/xlsx/ppt/zip/图片…）会下载到 data/attachments/，
# 抽出正文与表格后参与检索。不配 key 也能用：文档全部本机解析，
# 只有「图片里的文字」需要 OCR。
#
# 申请百度 OCR： https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
#   → 创建应用 → 拿 API Key(AK) / Secret Key(SK) → 开通「通用文字识别」
# OCR_PROVIDER=baidu
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# OCR_ACCURATE=1                  # 1=高精度版（默认），0=标准版（免费额度更多）

# 附件抓取上限（可选微调）
# ATTACH_ENABLED=0                # 关掉附件下载与解析
# ATTACH_DIR=D:\path\to\attach    # 换个存放目录（默认 data/attachments）
# ATTACH_MAX_FILES=6              # 单篇通知最多下载几个附件
# ATTACH_MAX_MB=25                # 单个附件大小上限（MB）
# ATTACH_OCR=0                    # 本次不调用 OCR

# ---- 登录墙 / 统一身份认证（可选）----
# 校内部分栏目在 cas.scau.edu.cn 后面。填一次账号密码即可自动抓：
#   Web 界面 → 左下「⚙️ 设置」→「🔐 账号与登录」→ 保存并登录
#   命令行等价写法： python -m wayfinder login
# 验证码会自动 OCR；滑块 / 短信 / 双因子请改用 Cookie 导入：
#   python -m wayfinder login --cookie
#
# ⚠️ 账号密码**不写在这里**，只落在 .auth/credentials.json（已 gitignore）。
#    下面只是非机密的行为开关。
# AUTH_AUTO_LOGIN=1               # 撞到登录墙时自动登录（默认开）
# AUTH_OCR_CAPTCHA=1              # 验证码用 OCR（默认开）
# AUTH_CAPTCHA_ROUNDS=3           # 最多换几张验证码（1-8）
# AUTH_SERVICE=http://portal.scau.edu.cn/   # 登录后跳转地址
# AUTH_CAPTCHA_URL=               # 验证码图片地址（自动找不到时才填）

# ---- 抓取与检索（可选微调）----
# 前缀 WAYFINDER_* 是新的；旧的 HARNESS_* 仍然兼容。
# WAYFINDER_DATA_DIR=            # 换了就别删旧库，否则要重新抓
# WAYFINDER_MAX_PAGES=8          # 单栏目最多抓几页列表
# WAYFINDER_MAX_ARTICLES=120     # 单栏目最多入库几篇
# WAYFINDER_CONCURRENCY=5        # 并发请求数（对校方站点请勿调太高）
# WAYFINDER_AGENT_ROUNDS=2       # 缺口补检索轮数
# WAYFINDER_TOP_K=8              # 每条子查询取多少条证据
# WAYFINDER_EVIDENCE_DOCS=24     # 最多几篇证据进入生成
# WAYFINDER_EVIDENCE_CHARS=900   # 每篇证据截取多少字
# WAYFINDER_EVIDENCE_BUDGET=26000  # 证据正文总字符预算

# ---- Web 界面 ----
# WAYFINDER_HOST=127.0.0.1
# WAYFINDER_PORT=8848
