# ===== SCAU Harness 配置 =====
# 复制为 .env 后填入。 .env 已在 .gitignore 中，不会入库。
# 两种更省事的填法（都会先做一次真实调用验证再写进 .env，与手改本文件等价）：
#     python -m harness.cli setup-key         # 命令行
#     python -m harness.cli web → 右上角「⚙️ 设置」   # Web 界面
#
# 注意：Web 设置面板与 setup-key 写的是下面这三个**通用名字**（LLM_*），
# 并会顺手清掉同一文件里旧的 DEEPSEEK_* 同名配置，避免两套 key 互相打架。

# ---- LLM（必填）----
# 申请： https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-在这里粘贴你的key

# 可选：换成任意 OpenAI 兼容端点（Ollama / vLLM / 通义 / 智谱 / Kimi…）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 若用非 DeepSeek 端点，用这三个更通用的名字（Web 设置面板写的就是它们）：
# LLM_API_KEY=...
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b

# ---- 公网搜索（可选）----
# ddg    = DuckDuckGo Lite，无需 key（默认，实测中文结果可用）
# bocha  = 博查搜索，国内 API，最稳定（https://open.bochaai.com）
# tavily = Tavily（https://tavily.com）
# none   = 关闭公网检索，只用校内语料
WEB_SEARCH_PROVIDER=ddg
# BOCHA_API_KEY=
# TAVILY_API_KEY=

# ---- 附件解析与 OCR ----
# 通知里的附件（pdf/doc/docx/xls/xlsx/ppt/zip/图片…）会被下载到项目内的
# data/attachments/<年>/<月>/ 并抽出正文与表格，正文参与检索与回答。
# 不配任何 key 也能用：文档类附件全部本机解析，只有「图片里的文字」需要 OCR。
#
# 申请百度 OCR： https://console.bce.baidu.com/ai/#/ai/ocr/overview/index
#   → 创建应用 → 拿 API Key(AK) / Secret Key(SK) → 开通「通用文字识别」
# 两种填法（都会先真实调用验证，与手改本文件等价）：
#     python -m harness.cli ocr --api-key <AK> --secret-key <SK>
#     python -m harness.cli web → 左下「⚙️ 设置」→「🖼 附件与 OCR」
#
# OCR_PROVIDER=baidu              # baidu | none（不填则按有没有 key 自动判断）
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# OCR_ACCURATE=1                  # 1=高精度版（默认，更准），0=标准版（免费额度更多）

# 附件抓取上限（可选微调）
# ATTACH_ENABLED=0                # 关掉附件下载与解析（等价于 crawl --no-attachments）
# ATTACH_DIR=D:\path\to\attach    # 换一个存放目录（默认 data/attachments）
# ATTACH_MAX_FILES=6              # 单篇通知最多下载几个附件
# ATTACH_MAX_MB=25                # 单个附件大小上限（MB）
# ATTACH_OCR=0                    # 本次不调用 OCR（只解析文档，不认图）
# HARNESS_ATTACH_CHARS=1600       # 每篇证据里最多带多少字附件正文

# ---- 登录墙 / 统一身份认证（可选）----
# 校内有一部分栏目在 cas.scau.edu.cn 后面。填一次账号密码就能自动抓：
#   Web 界面 → 左下「⚙️ 设置」→「🔐 账号与登录」→ 填学号 + 密码 →「保存并登录」
#   命令行等价写法： python -m harness.cli login
# 登录页有图形验证码时会自动下载验证码图交给 OCR 识别，认错就换一张重试。
# 滑块 / 短信 / 双因子过不去，那种站点请改用 Cookie 导入：
#   python -m harness.cli login --cookie
#
# ⚠️ 账号密码**不写在这里**，只落在 .auth/credentials.json（已 gitignore、
#    权限收紧到当前用户）。下面这几个只是非机密的行为开关。
#
# AUTH_AUTO_LOGIN=1               # 抓取撞到登录墙时自动用保存的账号登录（默认开）
# AUTH_OCR_CAPTCHA=1              # 验证码用 OCR 识别（默认开；需要上面配好百度 OCR）
# AUTH_CAPTCHA_ROUNDS=3           # 验证码认错时最多换几张图重试（1-8）
# AUTH_SERVICE=http://portal.scau.edu.cn/   # 登录后跳转的目标地址（默认融合门户）
# AUTH_CAPTCHA_URL=               # 验证码图片地址；页面里自动找不到时才需要手填

# ---- 抓取与检索（可选微调）----
# HARNESS_MAX_PAGES=8              # 单栏目最多抓几页列表
# HARNESS_MAX_ARTICLES=120         # 单栏目最多入库几篇
# HARNESS_CONCURRENCY=5            # 并发请求数（对校方站点请勿调太高）
# HARNESS_AGENT_ROUNDS=2           # 缺口补检索轮数
# HARNESS_TOP_K=8                  # 每条子查询取多少条证据
# HARNESS_EVIDENCE_DOCS=24         # 最多几篇证据进入生成
# HARNESS_EVIDENCE_CHARS=900       # 每篇证据截取多少字
# HARNESS_EVIDENCE_BUDGET=26000    # 证据正文总字符预算

# ---- Web 界面 ----
# HARNESS_HOST=127.0.0.1
# HARNESS_PORT=8848
